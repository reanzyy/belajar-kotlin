<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: Minimalist Clean White (Apple / Stripe) -->
    <style name="Base.Theme.SmartRetailPOS" parent="Theme.Material3.Light.NoActionBar">

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status Bar: pure white, dark icons -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>

        <!-- Material 3 Surface Mappings -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_secondary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/pos_error_red</item>

        <!-- TextInputLayout: Apple outlined style -->
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>

        <!-- Snackbar -->
        <item name="snackbarStyle">@style/Widget.Snackbar.Custom</item>
        <item name="snackbarButtonStyle">@style/Widget.Snackbar.Button.Custom</item>
    </style>

    <style name="Theme.SmartRetailPOS" parent="Base.Theme.SmartRetailPOS" />

    <!-- ===== Snackbar Styles ===== -->
    <style name="Widget.Snackbar.Custom" parent="Widget.Material3.Snackbar">
        <item name="android:layout_margin">16dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Snackbar</item>
    </style>
    <style name="Widget.Snackbar.Button.Custom" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/pos_warning_yellow</item>
    </style>
    <style name="ShapeAppearance.Snackbar" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- ===== Text Appearance Styles (must extend TextAppearance) ===== -->

    <!-- Uppercase section label: 11sp, muted, letter-spaced -->
    <style name="TextAppearance.App.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Card title: 17sp, charcoal, medium weight -->
    <style name="TextAppearance.App.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Hero amount: 28sp, tight tracking -->
    <style name="TextAppearance.App.HeroAmount" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- ===== TextInputLayout: Apple outlined feel ===== -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

</resources>
